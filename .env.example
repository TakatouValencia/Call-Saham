# ========================================================
# CALL EANOVAIRE - ENVIRONMENT CONFIGURATION
# ========================================================

# --- AI Configuration ---
# Pilihan provider: "gemini" atau "openai"
AI_PROVIDER=gemini

# Masukkan API Key sesuai provider yang dipilih
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
OPENAI_API_KEY=sk-proj-YourOpenAiApiKeyHere

# Model name (opsional, default: gemini-2.5-flash atau gpt-4o-mini)
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# --- Telegram Notifier Configuration ---
# Token Bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz
# Chat ID tujuan (Bisa user ID pribadi atau Channel/Group ID, contoh: -100123456789)
TELEGRAM_CHAT_ID=-1001234567890

# --- Discord Notifier Configuration (Output Webhook) ---
# Webhook URL Discord untuk mengirim notifikasi hasil sinyal
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/1553037927561302088/gh_xgKous0s7_08G_3BOSdA2OJWh3ImlyWpGWgn9xL4I1c1N_nVg5jqEFGHNjwp82rLT

# --- Discord Listener Configuration ---
# Bot Token dari Discord Developer Portal
DISCORD_BOT_TOKEN=MTAyND...YourDiscordBotTokenHere
# ID Channel Discord yang ingin dipantau (pisahkan dengan koma jika lebih dari 1)
# Contoh: 123456789012345678,987654321098765432
DISCORD_CHANNEL_IDS=123456789012345678

# --- Webhook Server Configuration (Untuk Input dari Web / TradingView / Scraper) ---
WEBHOOK_ENABLE=true
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
# Secret token untuk proteksi endpoint webhook (opsional)
WEBHOOK_SECRET=eanovaire_secret_key_2026
